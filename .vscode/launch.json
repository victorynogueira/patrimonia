{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node-terminal",
      "name": "Patrimônia: iniciar servidor (npm run dev)",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "pattern": "Local:\\s+http://localhost:([0-9]+)",
        "uriFormat": "http://localhost:%s",
        "action": "openExternally"
      }
    }
  ]
}
